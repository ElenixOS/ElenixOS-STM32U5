{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Download ElenixOS STM32U5 (ST-LINK)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build ElenixOS STM32U5",
            "command": "cube programmer -c port=SWD -w \"${workspaceFolder}/build/ElenixOS-STM32U5.elf\" -v -rst"
        },
        {
            "name": "Debug ElenixOS STM32U5 (ST-LINK)",
            "type": "stlinkgdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build ElenixOS STM32U5",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/ElenixOS-STM32U5.elf"
                }
            ],
            "runEntry": "main",
            "deviceName": "STM32U5G9ZJT6Q",
            "deviceCore": "Cortex-M33",
            "deviceTrustzone": "TZ-disabled",
            "serverInterface": "SWD",
            "serverInterfaceFrequency": "8000",
            "serverCubeProgPath": "${command:st-stm32-ide-debug-launch.get-programmer-path}",
            "serverVerify": true
        }
    ]
}